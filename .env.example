# ============================================================
# 《纸片人男友》环境变量模板
# 复制此文件为 .env.local 并填入真实值
# .env.local 已加入 .gitignore，不会提交到 Git
# ============================================================

# App
NEXT_PUBLIC_APP_URL=https://paperboyfriend.xyz

# Database - Neon PostgreSQL 连接字符串
# 在 https://neon.tech 创建项目后获得
DATABASE_URL=

# Auth - Better Auth
# BETTER_AUTH_SECRET: 随机字符串，用于加密 session
# BETTER_AUTH_URL: 应用完整 URL（本地开发用 http://localhost:3000）
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://paperboyfriend.xyz

# Google OAuth
# 在 https://console.cloud.google.com 创建 OAuth 2.0 客户端
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile - 人机验证
# 在 https://dash.cloudflare.com 创建 Turnstile 站点
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 - 文件存储
# 在 https://dash.cloudflare.com 创建 R2 bucket 和 API token
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# AI Provider - LLM（大语言模型）
# 支持 OpenAI / 硅基流动 / 其他兼容 OpenAI 格式的 API
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# AI Provider - STT（语音转文字）
# 服务商: 火山引擎 / 豆包大模型语音识别
STT_PROVIDER=volcano
STT_BASE_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
STT_APPID=
STT_TOKEN=
STT_RESOURCE_ID=volc.bigasr.sauc.duration

# AI Provider - VLM（视觉语言模型，图片理解）
VLM_PROVIDER=
VLM_API_KEY=
VLM_BASE_URL=
VLM_MODEL=

# AI Provider - TTS（文字转语音，男友语音）
TTS_PROVIDER=
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=

# AI Provider - Image（图像生成，男友照片）
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

# Cloudflare R2 - 文件存储
# 在 https://dash.cloudflare.com 创建 R2 bucket 和 API token
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Email - Resend
# 在 https://resend.com 获取 API key
RESEND_API_KEY=
EMAIL_FROM=

# Cron Job - 定时任务安全密钥
# 在 https://cron-job.org 配置请求时携带此 secret
CRON_SECRET=

# 业务配置参数
CHAT_CONTEXT_MESSAGE_LIMIT=20
MEMORY_BATCH_SIZE=50
IMAGE_RECENT_MESSAGE_WINDOW=8
IMAGE_RECENT_MAX_COUNT=2
